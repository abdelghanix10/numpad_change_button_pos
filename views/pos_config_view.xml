<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_numpad" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.numpad</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">
                <div class="row mt16 o_settings_container">
                    <setting string="Custom Numpad Buttons" help="Change % to +, Price to -, and +/- to Delete">
                        <field name="iface_custom_numpad"/>
                    </setting>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
